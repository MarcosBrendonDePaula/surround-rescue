{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Surround Rescue",
  "version": "0.4.0",
  "identifier": "dev.surround-rescue.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Surround Rescue",
        "width": 920,
        "height": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "resources/EqualizerAPO-x64.exe",
      "resources/THIRD-PARTY.txt"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./installer.nsh",
        "languages": [
          "PortugueseBR"
        ]
      }
    }
  }
}