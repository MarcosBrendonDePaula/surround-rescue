{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Surround Rescue",
  "version": "0.1.0",
  "identifier": "dev.surround-rescue.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Surround Rescue",
        "width": 920,
        "height": 640,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
