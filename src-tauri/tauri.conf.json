{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Surround Rescue",
  "version": "0.6.7",
  "identifier": "dev.surround-rescue.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Surround Rescue",
        "width": 1180,
        "height": 760,
        "resizable": true,
        "decorations": false,
        "minWidth": 860,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "resources/EqualizerAPO-x64.exe": "resources/EqualizerAPO-x64.exe",
      "resources/THIRD-PARTY.txt": "resources/THIRD-PARTY.txt",
      "../target/release/sr_apo.dll": "sr_apo.dll",
      "../target/i686-pc-windows-msvc/release/sr-bridge32.exe": "sr-bridge32.exe"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./installer.nsh",
        "languages": [
          "PortugueseBR"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2RERFMzg4Mzk0NTFEM0QKUldROUhVVTVpT1BkZGt0MDcyQTFBZUd2UjFSNG1rU0o2Z0lHWnlid1dLV1FTNGRxYW1oM3ljb3YK",
      "endpoints": [
        "https://github.com/MarcosBrendonDePaula/surround-rescue/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}